@ECHO OFF
REM FDAUTO.BAT - FreeDOS boot chain into C:
IF "%CONFIG%"=="1" SET ROUTE=LANTIRC6
IF "%CONFIG%"=="2" SET ROUTE=386MAX
IF "%CONFIG%"=="3" SET ROUTE=BARE
IF "%ROUTE%"=="" SET ROUTE=LANTIRC6

SET DOSDIR=A:\FDOS
PATH=A:\FDOS;C:\;C:\FDOS\BIN
C:
CD \
IF EXIST C:\AUTOEXEC.BAT CALL C:\AUTOEXEC.BAT
