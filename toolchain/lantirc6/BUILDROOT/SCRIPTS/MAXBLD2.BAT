@ECHO OFF
REM MAXBLD2.BAT - Assemble + link (Phases 6-9). Run after MAXBLD1.BAT.
SET MAX_SRC=C:\386MAX_S
SET MAX_XFORM=%MAX_SRC%\XFORM
SET MAX_XINC=%MAX_SRC%\XINC
SET MAX_INCL=%MAX_SRC%\INCLUDE
SET MAX_OBJ=%MAX_SRC%\OBJ
SET MAX_BIN=%MAX_SRC%\BIN
SET SED=C:\FDOS\BIN\SED.EXE
SET TASMX=C:\BC31\BIN\TASMX.EXE
SET TLINK=C:\BC31\BIN\TLINK.EXE

IF NOT EXIST %MAX_BIN%\NUL MKDIR %MAX_BIN%

ECHO P6: load HDPMI16 ...
C:\HX\HDPMI16.EXE -r > NUL

ECHO P7: assemble with TASMX ...
CD %MAX_XFORM%
DEL C:\TMP\BLD_ASM.TXT > NUL
FOR %%F IN (*.ASM) DO %TASMX% /JMASM51 /M9 /I%MAX_XINC% /I%MAX_INCL% /I%MAX_XFORM% %%F %MAX_OBJ%\ >> C:\TMP\BLD_ASM.TXT

ECHO P7b: unload HDPMI16 ...
C:\HX\HDPMI16.EXE -u > NUL

ECHO P8: link ...
CD %MAX_OBJ%
REM Build 386MAX.SYS from the SYSOBJS list in original MAKEFILE (67 modules).
REM Everything else in OBJ is either HILO (separate .EXE) or UTIL_*
REM (utility programs, separate). Using explicit list avoids
REM duplicate-symbol and undefined-symbol errors from HILO/UTIL_* linkage.
DEL _LINK.TMP > NUL
FOR %%F IN (QMAX QMAX_ARG QMAX_BCF QMAX_CPQ QMAX_DBG QMAX_DM2 QMAX_DMA QMAX_EEM QMAX_EM2 QMAX_EM4 QMAX_EMX QMAX_EVM QMAX_FCN QMAX_I09 QMAX_I0D QMAX_I0E QMAX_I15 QMAX_I21 QMAX_I31 QMAX_I4B) DO ECHO %%F.OBJ+ >> _LINK.TMP
FOR %%F IN (QMAX_I67 QMAX_IDT QMAX_IN2 QMAX_INI QMAX_IOP QMAX_KEY QMAX_LOD QMAX_MAC QMAX_MEM QMAX_MSG QMAX_OEM QMAX_OSE QMAX_OVR QMAX_PDT QMAX_PMR QMAX_POS QMAX_SCR QMAX_SIZ QMAX_STA QMAX_SWP) DO ECHO %%F.OBJ+ >> _LINK.TMP
FOR %%F IN (QMAX_SYS QMAX_TIM QMAX_VCP QMAX_XMS VERSRET VERSBETA QMAX_D10 QMAX_D15 QMAX_D21 QMAX_D33 QMAX_DIF QMAX_J31 QMAX_K31 QMAX_L31 QMAX_M31 QMAX_N31 QMAX_IM2 QMAX_MBT QMAX_BSM QMAX_LSM) DO ECHO %%F.OBJ+ >> _LINK.TMP
FOR %%F IN (QMAX_PPM QMAX_VME QMAX_VMM QMAX_SHR QMAX_RSP QMAX_PNP QMAX_O31) DO ECHO %%F.OBJ+ >> _LINK.TMP

%SED% "s/[ 	]*+[ 	]*$/+/; $s/[ 	]*+[ 	]*$/,386MAX.SYS,386MAX.MAP/; s/[ 	]*$//" _LINK.TMP > _LINK.RSP
DEL _LINK.TMP > NUL

IF EXIST 386MAX.SYS DEL 386MAX.SYS > NUL
IF EXIST 386MAX.MAP DEL 386MAX.MAP > NUL
IF EXIST %MAX_BIN%\386MAX.SYS DEL %MAX_BIN%\386MAX.SYS > NUL
IF EXIST %MAX_BIN%\386MAX.MAP DEL %MAX_BIN%\386MAX.MAP > NUL
DEL C:\TMP\BLD_LNK.TXT > NUL
%TLINK% /3 @_LINK.RSP > C:\TMP\BLD_LNK.TXT

IF EXIST 386MAX.SYS COPY 386MAX.SYS %MAX_BIN%\386MAX.SYS > NUL
IF EXIST 386MAX.SYS DEL 386MAX.SYS > NUL
IF EXIST 386MAX.MAP COPY 386MAX.MAP %MAX_BIN%\386MAX.MAP > NUL
IF EXIST 386MAX.MAP DEL 386MAX.MAP > NUL

ECHO P9: report ...
DIR %MAX_OBJ%\*.OBJ > C:\TMP\BLD_OBJS.TXT
DIR %MAX_BIN%\*.* > C:\TMP\BLD_BIN.TXT
ECHO P2 DONE > C:\TMP\P2_DONE.TXT
CD C:\
