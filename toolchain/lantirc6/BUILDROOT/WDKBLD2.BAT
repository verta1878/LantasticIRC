@echo off
set PATH=C:\MSC51\BIN
set INCLUDE=C:\WDKSDK\INCLUDE;C:\MSC60A\INCLUDE
set LIB=C:\MSC51\LIB
set TMP=C:\
echo === LZH === > C:\WDKBL2.LOG
cl /c /W0 /AL /IC:\WDKSDK\INCLUDE C:\WDKSDK\SRC\LZH.C >> C:\WDKBL2.LOG
echo === NOSARCH === >> C:\WDKBL2.LOG
cl /c /W0 /AL /IC:\WDKSDK\INCLUDE C:\WDKSDK\SRC\NOSARCH.C >> C:\WDKBL2.LOG
echo === DOSIO === >> C:\WDKBL2.LOG
cl /c /W0 /AL /IC:\WDKSDK\INCLUDE C:\WDKSDK\SRC\DOSIO.C >> C:\WDKBL2.LOG
echo === NOSEXT === >> C:\WDKBL2.LOG
cl /c /W0 /AL /IC:\WDKSDK\INCLUDE C:\WDKSDK\TOOLS\NOSEXT.C >> C:\WDKBL2.LOG
