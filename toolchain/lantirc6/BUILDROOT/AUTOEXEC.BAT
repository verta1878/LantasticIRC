@ECHO OFF
REM AUTOEXEC.BAT - route dispatcher for LANtastic IRC build system

SET TMP=C:\TMP
SET TEMP=C:\TMP
IF NOT EXIST C:\TMP MD C:\TMP
DEL C:\TMP\*.TXT > NUL
ECHO CONFIG=%CONFIG% ROUTE=%ROUTE% > C:\TMP\BOOT.LOG

IF NOT "%ROUTE%"=="" SET CONFIG=%ROUTE%

IF "%CONFIG%"=="LANTIRC6" GOTO LANTIRC6
IF "%CONFIG%"=="386MAX"   GOTO M386
IF "%CONFIG%"=="BARE"     GOTO BARE
GOTO LANTIRC6

:LANTIRC6
ECHO Route: LANtastic v6 - MSC 6.0a
ECHO Route: LANtastic v6 - MSC 6.0a >> C:\TMP\BOOT.LOG
SET PATH=C:\MSC60A\BIN;C:\FDOS\BIN;C:\
SET INCLUDE=C:\MSC60A\INCLUDE
SET LIB=C:\MSC60A\LIB
GOTO END

:M386
ECHO Route: 386MAX via CONFIG.SYS
ECHO Route: 386MAX >> C:\TMP\BOOT.LOG
SET PATH=C:\MSC70\BIN;C:\BC31\BIN;C:\FDOS\BIN;C:\
SET INCLUDE=C:\MSC70\INCLUDE
SET LIB=C:\MSC70\LIB
GOTO END

:BARE
ECHO Bare boot - real-mode tools only
ECHO Bare boot >> C:\TMP\BOOT.LOG
SET PATH=C:\MSC60A\BIN;C:\FDOS\BIN;C:\
SET INCLUDE=C:\MSC60A\INCLUDE
SET LIB=C:\MSC60A\LIB
GOTO END

:END
ECHO.
ECHO Ready. Route=%CONFIG%
ECHO Ready > C:\TMP\READY.TXT
