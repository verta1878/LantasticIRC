# MAKEFILE for INST6.EXE — MSC 6.0a
# Run: NMAKE from DOSBox-X

CC = cl
CFLAGS = /c /W0 /Ox /AL
LINK = link
LFLAGS = /NOI /STACK:128

OBJS = INST6.OBJ STUBS.OBJ LZH.OBJ NOSARCH.OBJ DOSIO.OBJ HELPERS.OBJ

all: INST6.EXE

.c.obj:
	$(CC) $(CFLAGS) $*.c

INST6.EXE: $(OBJS)
	$(LINK) $(LFLAGS) $(OBJS),INST6.EXE,NUL,SLIBCE;

clean:
	del *.obj
	del INST6.EXE
